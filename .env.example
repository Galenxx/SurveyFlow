# LLM Configuration - Multi-Provider Setup
#
# DeepSeek API (for QueryAgent, GapAgent, RetrieverAgent, SectionAgent, WriterAgent)
# API docs: https://api-docs.deepseek.com/zh-cn/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_CONTEXT_WINDOW=64000

# Zhipu AI API (for ClassifierAgent, OutlineAgent)
# API docs: https://docs.bigmodel.cn/cn/api/introduction#curl
OPENAI_API_KEY=your_zhipuai_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.1
ZHIPU_MODEL_CONTEXT_WINDOW=128000

# Zhipu AI Embedding (used by SplitterAgent and RetrieverAgent for vector retrieval)
# API docs: https://docs.bigmodel.cn/cn/guide/models/embedding/embedding-3
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# Token Safety
TOKEN_SAFETY_MARGIN=512
MIN_COMPLETION_TOKENS=256

# ChromaDB
CHROMADB_PERSIST_DIRECTORY=./data/chroma

# Data Paths
DATA_ROOT=./data
PDF_PATH=./data/pdf
MD_PATH=./data/md
TSV_PATH=./data/tsv
TXT_PATH=./data/txt
CHROMA_PATH=./data/chroma

# arXiv Download
ARXIV_PARENT_FOLDER=./data/arxiv_downloads

# Semantic Scholar S2 API (for paper search beyond arXiv)
# Get your key at: https://www.semanticscholar.org/product/api
# The free tier allows 1 request/second with API key
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# API Server
API_HOST=0.0.0.0
API_PORT=8000
